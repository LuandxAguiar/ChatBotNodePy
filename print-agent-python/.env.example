# Copie para .env e edite
SECRET_TOKEN=troque-este-segredo       # HMAC opcional para autenticar o /print
PRINTER_NAME=                          # Nome padrão da impressora (opcional)
JOBS_DIR=/mnt/data/print-agent-fastapi/jobs

# Somente Windows (impressão silenciosa)
# Baixe o SumatraPDF e aponte o caminho completo:
# https://www.sumatrapdfreader.org/download-free-pdf-viewer
SUMATRA_PATH=C:\\Tools\\SumatraPDF.exe
